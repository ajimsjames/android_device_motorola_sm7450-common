cc_prebuilt_library_shared {
    name: "com.qualcomm.qti.bluetooth_audio@1.0_system_ext",
    stem: "com.qualcomm.qti.bluetooth_audio@1.0",
    check_elf_files: false,
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["system_ext_lib64/com.qualcomm.qti.bluetooth_audio@1.0.so"],
        },
        android_arm: {
            srcs: ["system_ext_lib/com.qualcomm.qti.bluetooth_audio@1.0.so"],
        },
    },
    compile_multilib: "both",
    prefer: true,
    system_ext_specific: true,
}

android_app_import {
    name: "MotoBtAptxMode",
    apk: "app/MotoBtAptxMode/MotoBtAptxMode.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

