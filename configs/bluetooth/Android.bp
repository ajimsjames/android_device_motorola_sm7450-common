cc_prebuilt_library_shared {
    name: "liblhdc",
    check_elf_files: false,
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["lib64/liblhdc.so"],
        },
        android_arm: {
            srcs: ["lib/liblhdc.so"],
        },
    },
    compile_multilib: "both",
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "liblhdcBT_enc",
    check_elf_files: false,
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["lib64/liblhdcBT_enc.so"],
        },
        android_arm: {
            srcs: ["lib/liblhdcBT_enc.so"],
        },
    },
    compile_multilib: "both",
    prefer: true,
}

